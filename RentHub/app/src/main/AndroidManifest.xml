<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RentHub">
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.EditProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RoleSelectionActivity"
            android:exported="true" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="true" />

        <!-- Chuyển intent-filter sang LoginActivity để màn hình này chạy lên đầu tiên -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.LandlordHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.home.TenantHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.invoice.InvoiceListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.invoice.AddEditInvoiceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.invoice.TenantInvoiceDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.room.LandlordRoomListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.room.AddEditRoomActivity"
            android:exported="false" />

        <activity
            android:name=".ui.room.RoomDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="true" />

        <activity
            android:name=".ui.landlord.LandlordMainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tenant.TenantMainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.ChangePasswordActivity"
            android:exported="false" />
        <activity android:name=".ui.issue.IssueListActivity" />
        <activity android:name=".ui.issue.CreateIssueActivity" />
        <activity android:name=".ui.issue.IssueDetailActivity" />
    </application>
</manifest>