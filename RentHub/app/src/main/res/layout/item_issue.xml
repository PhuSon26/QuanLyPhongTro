<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Dòng 1: Tiêu đề + Mức độ ưu tiên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIssueTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#0D2C42"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Hỏng vòi nước bồn rửa" />

            <TextView
                android:id="@+id/tvIssuePriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_priority_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Ưu tiên cao" />
        </LinearLayout>

        <!-- Dòng 2: Phòng trọ + Loại sự cố -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/rh_ic_room"
                app:tint="#0E8B75"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvIssueRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#0E8B75"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Phòng 101" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/tvIssueType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="Loại: Nước" />

            <!-- Icon có ảnh đính kèm -->
            <ImageView
                android:id="@+id/ivHasImageIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_camera"
                android:visibility="gone"
                app:tint="#64748B"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Dòng 3: Trạng thái + Ngày gửi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIssueStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Chờ xử lý" />

            <TextView
                android:id="@+id/tvIssueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="13/10/2026 00:00" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
